FINN_PORT=8090
FINN_AUTO_REFRESH=1
FINN_REFRESH_SECONDS=900

# Local workspaces by default. Public mode always forces AI off.
# Public mode with INTERACTIVE_DEMO=1 allows isolated, expiring synthetic workspaces.
FINN_PUBLIC_DEMO=0
FINN_INTERACTIVE_DEMO=0
FINN_TRUST_PROXY=0
# Optional override; blank generates a persistent signing secret in the protected local database.
FINN_SESSION_SECRET=

# Core research, monitoring and network lookup work without model credentials.
# Optional AI synthesis stays off until explicitly enabled.
FINN_ENABLE_LLM=0

# Add either key to .env (already ignored). The rest of FINN works without a key.
# auto: Gemini when available; otherwise OpenAI. With both keys, Gemini wins.
# Set gemini or openai to select a provider explicitly. No fallback after failure.
FINN_LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
FINN_GEMINI_MODEL=gemini-3.8-flash
FINN_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
FINN_LLM_TIMEOUT_SECONDS=240
# Older FINN_RESEARCH_MODEL settings remain supported for OpenAI only.
