FINN_PORT=8090
FINN_AUTO_REFRESH=1
FINN_REFRESH_SECONDS=900

# Local workspaces by default. Public AI requires a separate free-only opt-in.
# Public mode with INTERACTIVE_DEMO=1 allows isolated, expiring synthetic workspaces.
FINN_PUBLIC_DEMO=0
FINN_INTERACTIVE_DEMO=0
FINN_TRUST_PROXY=0
# Optional override; blank generates a persistent signing secret in the protected local database.
FINN_SESSION_SECRET=

# Core research, monitoring and network lookup work without model credentials.
# Optional AI synthesis stays off until explicitly enabled.
FINN_ENABLE_LLM=0
# Public interactive deployments additionally require 1 here; OpenRouter only.
# Fixed limits: 3 starts/workspace/hour, 5 globally/hour, 15 globally/24h, one at a time.
FINN_PUBLIC_LLM=0

# Add your key to .env (already ignored). The rest of FINN works without a key.
# OpenRouter is the default optional provider, using free-only models.
# auto selects the first configured key: OpenRouter, Gemini, OpenAI.
# Set openrouter, gemini or openai explicitly. No fallback after failure.
FINN_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# The free router selects an available compatible free model. Pin author/model:free if desired.
# Paid OpenRouter model IDs are rejected; no credit purchase is required for :free variants.
FINN_OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
OPENAI_API_KEY=
FINN_GEMINI_MODEL=gemini-3.8-flash
FINN_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
FINN_LLM_TIMEOUT_SECONDS=240
# Older FINN_RESEARCH_MODEL settings remain supported for OpenAI only.
